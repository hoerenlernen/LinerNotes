# Liner Notes – Konfigurationsvorlage
#
# Kopieren nach ~/.config/liner/liner.env und anpassen (chmod 600!).
# Der systemd-Unit liest sie über EnvironmentFile.
#
# Keiner dieser Werte steht im Quelltext. Was hier fehlt, wird entweder
# gesucht (Player, Medienserver per SSDP) oder hat einen neutralen
# Standardwert.

# ---------------------------------------------------------------- Pfade
# Wurzel der Musikbibliothek. Im normalen Betrieb nur gelesen;
# tagvault restore --apply ist ein separates, schreibendes Wartungswerkzeug.
LINER_MUSIC_ROOT=/pfad/zur/musik
# Sidecar-Datenbank und Cover-Zwischenspeicher. Standard: ./data/
#LINER_DB=/pfad/zu/liner/data/liner.db
#LINER_COVERDIR=/pfad/zu/liner/data/cover

# --------------------------------------------------------------- Server
LINER_PORT=5060
# Standard: nur dieser Rechner. Für LAN-Zugriff eigene Server-LAN-IP setzen.
LINER_BIND=127.0.0.1
# Vollständige Callback-URL, vom Linn erreichbar (inklusive /notify):
#LINER_CALLBACK_BASIS=http://192.168.1.10:5060/notify

# --------------------------------------------- Player (OpenHome / Linn)
# Ohne diese Angaben wird per SSDP gesucht. Bei mehreren Playern im Netz
# grenzt LINN_NAME ein (Teil des Gerätenamens genügt).
#LINN_HOST=192.168.1.20
#LINN_PORT=55178
#LINN_UDN=00000000-0000-0000-0000-000000000000
#LINN_NAME=Wohnzimmer

# ------------------------------------ Medienserver (UPnP / MinimServer)
# Ebenfalls per SSDP gesucht, wenn nicht gesetzt.
#MINIM_BASIS=http://192.168.1.10:9791
#MINIM_UDN=00000000-0000-0000-0000-000000000000
#MINIM_NAME=Musik

# ------------------------------------------------------------ Steuerung
# 0 macht die Anzeige zum reinen Lesegerät (keine Endpunkte, keine Leiste).
LINER_STEUERUNG=1
# Obergrenze der Lautstärke, die dieser Dienst zulässt, und die größte
# Änderung pro Befehl. Bewusst konservativ.
LINER_VOL_MAX=65
LINER_VOL_SCHRITT_MAX=5

# ----------------------------------------------- Navidrome (Spiegelung)
# Markierte Titel erscheinen dann auch in Feishin, play:sub, Amperfy.
# 0 schaltet die Spiegelung ab.
NAVIDROME_SPIEGELN=1
#NAVIDROME_URL=http://127.0.0.1:4533
#NAVIDROME_USER=benutzer
#NAVIDROME_PASS="passwort"
# Navidromes Datenbank wird nur LESEND geöffnet, um Song-Ids zu finden.
#NAVIDROME_DB=/var/lib/navidrome/navidrome.db

# ------------------------------------------- Externe Quellen (optional)
#LASTFM_API_KEY=
#LASTFM_SHARED_SECRET=
#MB_USER_AGENT=LinerNotes/1.0 ( deine@mailadresse )
#DISCOGS_TOKEN=

# Hörhinweise: separates, optionales Inhaltsrepository
#HOERENLERNEN_PFAD=/pfad/zu/hoeren-lernen
HOERENLERNEN_MODUS=album
# Zusätzliche erlaubte Browser-Origins (kommagetrennt), normalerweise leer
#LINER_ORIGINS=https://liner.example.org
# Zusätzliche erlaubte Cover-Server: nur numerische IP-Adressen
#LINER_COVER_HOSTS=192.168.1.10
